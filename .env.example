# Copie este arquivo para ".env" e preencha com os valores reais.
# Nunca commite o ".env" (ele está no .gitignore).

# Aplicação
SERVER_PORT=8081
SWAGGER_ENABLED=true

# Banco de dados (MySQL compartilhado na porta 3306, database próprio)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=order_db
DB_USERNAME=
DB_PASSWORD=
